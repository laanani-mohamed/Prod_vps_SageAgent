[Unit]
Description=API BI Sage - FastAPI & Uvicorn
# Attend que le réseau et PostgreSQL soient prêts
After=network.target postgresql.service

# Protection contre la Boucle Infinie
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
User=amohamed
Group=amohamed

# Dossier racine du projet
WorkingDirectory=/opt/SageAgent/app

# Lancement de l'API avec Uvicorn depuis l'environnement virtuel
ExecStart=/opt/SageAgent/app/.venv/bin/uvicorn api.main:app --app-dir src --host 0.0.0.0 --port 8000

# Redémarrage automatique en cas de crash
Restart=always
RestartSec=10

# Empêche Python de retenir les logs en mémoire
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target


-------------
# Activer les services au démarrage du serveur
sudo systemctl enable SageAgent_api.service

# Démarrer les services immédiatement
sudo systemctl start SageAgent_api.service

# Vérifier le statut
sudo systemctl status SageAgent_api.service